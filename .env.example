PORT=3000

# Provider: use comfyui (or h3) for MiniMax H3 Character Sheet Generator.
IMAGE_PROVIDER=comfyui

# GPU ComfyUI server running the H3 workflow.
COMFYUI_URL=https://your-comfyui-server.example.com
H3_WORKFLOW_URL=https://huggingface.co/PoopMan333/H3_Character_Sheet_Generator/raw/main/H3_CharSheetMaker_4_Panel_%28Faster%29.json
COMFYUI_TIMEOUT_MS=900000
COMFYUI_POLL_MS=2500

# Only needed when IMAGE_PROVIDER=huggingface.
HF_TOKEN=hf_your_server_side_token_here
IMAGE_MODEL=black-forest-labs/FLUX.2-dev
IMAGE_GUIDANCE=5.5
IMAGE_STEPS=28

MAX_UPLOAD_MB=8
